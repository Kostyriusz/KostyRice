// ~/.config/waybar/config-taskbar.jsonc
{
    "layer": "top",
    "position": "left",        // pasek z boku
    "width": 45,                // wąski, pionowy pasek
    "modules-left": ["wlr/taskbar"],

    "margin-top": 4,
    "margin-bottom": 4,
    "margin-left": 4,
    "margin-right": 0,

    "padding-top": 4,
    "padding-bottom": 4,
    "padding-left": 4,
    "padding-right": 0,

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "orientation": "vertical",   // ikonki jedna pod drugą
        "tooltip-format": "{title}",
        "on-click": "activate",
        "spacing": 8,
        "icon-position": "bottom"
    }
}