// plik: ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",                        // protokół obrazków kitty
    "source": "/home/kostyriusz/.config/fastfetch/Joy_Boykisser.png",     // podmień na ścieżkę do swojego pliku
    "width": 30,                            // szerokość w komórkach
    "preserveAspectRatio": true                      // wysokość w komórkach
  },
  "display": {
    "color": {
      "keys": "#9d4edd",
      "title": "#9d4edd"            // kolor kluczy
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "poweradapter",
    "localip",
    "locale",
    "break",
    "colors"
  ]
}